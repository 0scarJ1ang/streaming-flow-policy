    <geometry>
      <cylinder radius="0.04" length="0.06"/>
    </geometry>
  </collision>
</link>

<!-- Fake target (end effector target for planning, simplified primitive) -->
<link name="fake_target">
  <visual>
    <origin xyz="0 0 0.2" rpy="0 0 3.14159265359"/>
    <geometry>
      <cylinder radius="0.02" length="0.05"/>
    </geometry>
    <material name="red"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.2" rpy="0 0 3.14159265359"/>
    <geometry>
      <cylinder radius="0.02" length="0.05"/>
    </geometry>
  </collision>
</link>

<!-- Fixed joint from Robotiq base to fake target -->
<joint name="fake_target_joint" type="fixed">
  <parent link="robotiq_arg2f_base_link"/>
  <child link="fake_target"/>
  <origin xyz="0 0 0.2" rpy="0 0 0"/>
  <axis xyz="0 -1 0"/>
</joint>

